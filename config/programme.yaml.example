# Example programme config — copy to config/programme.yaml for local runs.
# Secrets (webhook secret, App key, programme token, DB URLs) must NOT appear here.
#
# INIT-GATEFLOW-002: trigger.label is retained for docs/migration only.
# Label-based wave start is disabled — use POST /api/v1/waves/start.

trigger:
  label: gateflow:run-wave

handoff:
  ref: pr_head
  ref_fallback: default_branch
  artifact_globs:
    - docs/specification/reports/**/*
    - prd/reports/**/*

retry:
  findings_budget: 3

metrics:
  retention_days: 90

runner:
  default: cursor

model:
  profiles:
    default: cursor/auto
    loop: cursor/fast
    ground: cursor/auto
  # Legacy string form still accepted (coerced to {profile: "..."}):
  #   overrides:
  #     some_node: my-profile
  # Prefer object form with profile and/or runner:
  overrides:
    loop-spec:
      profile: loop
      runner: cursor
    ground-spec:
      profile: ground
      runner: cursor

tools:
  slots: {}

notifier:
  default: github_comment

pr:
  branch_prefix: gateflow/run-
  title_template: "[gateflow] {initiative_id} {wave_id} {run_id_short}"
  body_template: "Run `{run_id}` — status API supplementary."
  base_branch: develop
