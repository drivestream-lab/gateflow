# gateflow — copy to .env for local development (Gateflow *runtime* process only).
# Live verify client knobs live in tests/config.yaml (see tests/config.yaml.example).
# Do not put programme-owned GitHub PATs here — those are set on
# POST /api/v1/programmes and stored in programmes.github_pat (REQ-11 / ADR-015).

APP_PORT=8080
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_LOG_TO_CONSOLE=true
APP_LOG_DIR=logs

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=drivestream
POSTGRES_PASSWORD=drivestream
POSTGRES_DB=ds_gateflow_db
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=ds_gateflow:
REDIS_DEFAULT_TTL=3600

JWT_ALGORITHM=RS256
JWT_ISSUER=gateflow
JWT_AUDIENCE=drivestream
# RS256 PEM paths — keep keys outside the repo (e.g. sibling ../auth-keys/)
# JWT_PRIVATE_KEY_PATH=/absolute/path/to/gateflow-jwt-private.pem
# JWT_PUBLIC_KEY_PATH=/absolute/path/to/gateflow-jwt-public.pem
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- GitHub (runtime) ---
# Webhook HMAC — Gateflow ingress. Mirror the same value into
# tests/config.yaml → client.github_webhook_secret for verify signing.
GITHUB_WEBHOOK_SECRET=replace-with-github-app-webhook-secret

# Process-singleton ForgeClient (board / wave / notifier DI today).
# This is NOT the per-programme PAT (that lives in DB after programme create).
# Required: pat | app (explicit; no auto). Local: start with pat (ADR-003: no pat in production).
GITHUB_AUTH_MODE=pat
GITHUB_APP_ID=
# GITHUB_CLIENT_ID=  # optional; not read by gateflow yet (OAuth / GitHub alt id)
GITHUB_PRIVATE_KEY_PATH=
# Required when GITHUB_AUTH_MODE=pat (non-prod only):
GITHUB_PERSONAL_ACCESS_TOKEN=

# Cursor local AgentRunner (INIT-GATEFLOW-003). Required when wave-start runner is cursor.
# Never commit secrets; keep CURSOR_API_KEY in env / secret store only.
CURSOR_API_KEY=
# Optional SDK default when model id is auto/fast/empty:
# CURSOR_DEFAULT_MODEL=composer-2
# Cursor Python SDK troubleshooting (official): stderr handler on logger "cursor_sdk" only.
# Values: debug | info | unset. Docs: https://cursor.com/docs/sdk/python#troubleshooting
# Must be set in the Gateflow process env before import (restart make run after changing).
# CURSOR_SDK_LOG=debug
CURSOR_SDK_LOG=

# Orchestration ops (env — no programme.yaml):
GATEFLOW_FINDINGS_BUDGET=3
GATEFLOW_METRICS_RETENTION_DAYS=90
GATEFLOW_NOTIFIER=github_comment
GATEFLOW_MAX_ORCHESTRATED_HOPS=20
# Absolute dir for per-run handoff batons (INIT-GATEFLOW-005). Not under the git workspace.
# Example local: /tmp/gateflow/handoffs
GATEFLOW_HANDOFF_ROOT=

OTEL_SERVICE_NAME=gateflow
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
