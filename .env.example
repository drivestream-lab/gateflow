# gateflow — copy to .env for local development
# Application runtime only. Live verify knobs live in tests/config.yaml
# (see tests/config.yaml.example).

APP_PORT=8080
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
APP_LOG_TO_CONSOLE=true
APP_LOG_DIR=logs

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=drivestream
POSTGRES_PASSWORD=drivestream
POSTGRES_DB=ds_gateflow_db
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=ds_gateflow:
REDIS_DEFAULT_TTL=3600

JWT_ALGORITHM=RS256
JWT_ISSUER=gateflow
JWT_AUDIENCE=drivestream
JWT_PUBLIC_KEY_PATH=tests/fixtures/jwt_public.pem

# Org GitHub App (webhooks + installation tokens). No user OAuth required for W0/W1.
GITHUB_WEBHOOK_SECRET=replace-with-github-app-webhook-secret
# Required: pat | app (explicit; no auto). Local prove-it: start with pat.
GITHUB_AUTH_MODE=pat
GITHUB_APP_ID=
# GITHUB_CLIENT_ID=  # optional; not read by gateflow yet (OAuth / GitHub alt id)
GITHUB_PRIVATE_KEY_PATH=
# Required when GITHUB_AUTH_MODE=pat (non-prod only; ADR-003 forbids pat in production):
GITHUB_PERSONAL_ACCESS_TOKEN=

# Cursor local AgentRunner (INIT-GATEFLOW-003). Required when wave-start runner is cursor.
# Never commit secrets; keep CURSOR_API_KEY in env / secret store only.
CURSOR_API_KEY=
# Optional SDK default when model id is auto/fast/empty:
# CURSOR_DEFAULT_MODEL=composer-2

PROGRAMME_SERVICE_TOKEN=replace-me

# Orchestration ops (env — no programme.yaml):
GATEFLOW_FINDINGS_BUDGET=3
GATEFLOW_METRICS_RETENTION_DAYS=90
GATEFLOW_NOTIFIER=github_comment
GATEFLOW_MAX_ORCHESTRATED_HOPS=20
# Unit-test doubles only — must be empty/unset for live Cursor prove-it (Q-3):
GATEFLOW_AGENT_STUB=

OTEL_SERVICE_NAME=gateflow
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
