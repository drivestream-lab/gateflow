# Copy to tests/config.yaml (gitignored) for local live debug / verify.
#
# SSOT for verify/debug client knobs — scripts must not read process .env.
# Gateflow *runtime* still uses .env when you `make run` (DB, CURSOR_API_KEY,
# singleton ForgeClient GITHUB_* , GITHUB_WEBHOOK_SECRET on the server).
# Programme-owned PATs are NOT in .env — they are stored in programmes.github_pat
# after POST /api/v1/programmes (REQ-11 / ADR-015).
#
# verify_all needs: gateflow + auth.platform_admin + client.github_webhook_secret
#   + at least one Programme in Gateflow (tenant_admin may be empty → bootstrap attaches)
# Opt-in programme create: programme.pat (create body fixture only)
# GitHub-live paths: features.*.enabled / features.board.live_github

gateflow:
  base_url: http://127.0.0.1:8080
  # True when worker is up (PR-at-start assert in verify_pr_thread; required for lanes)
  require_worker: false
  org: drivestream-lab
  repo: gateflow
  base_branch: develop

# JWT identities for verify (local only — never commit real secrets).
# Scripts login via /api/auth/login and mint JWTs — do not put access tokens here.
auth:
  platform_admin:
    identifier: platform_admin@smoke.local
    password: replace-me-local-only
  # Optional: leave empty and verify_auth_bootstrap / verify_all will attach a
  # random tenant_admin to an existing programme and write credentials back here.
  tenant_admin:
    identifier: ""
    password: ""

# Verify-client secrets (sign webhooks the running API accepts).
client:
  github_webhook_secret: replace-me-same-as-runtime-GITHUB_WEBHOOK_SECRET

# Opt-in programme *create* (verify_programme_onboarding / bootstrap if none).
# programme.pat = create-body fixture in this file only (not .env).
# Gateflow stores it in programmes.github_pat after create.
# Default meta: drivestream-lab/prayog-meta.
# programme.programme_id: optional reuse for attach/bootstrap.
programme:
  pat: replace-me-non-production-github-pat
  org: drivestream-lab
  repo: prayog-meta
  ref: ""
  programme_id: ""

# Optional IDs for readout / isolation scripts (omit or leave empty when unused).
fixtures:
  legacy_opaque_token: test-programme-token
  initiative_id: ""
  wave_id: ""
  # tenant_a_token / tenant_b_token — cross-programme isolation only

# Product smoke (verify_all) uses gateflow: + ephemeral wave identity in scripts.
# Feature sections below are optional / opt-in (same pattern as implement_lane).

features:
  # Live GitHub forge mutations inside verify_board (default off).
  # Auth + validation edges always run; set true only when API forge is configured.
  board:
    live_github: false

  # Coding hops: pre-implement → loop-spec → STOP at wave-acceptance
  #   .venv/bin/python -m tests.verify.verify_implement_lane
  implement_lane:
    enabled: false
    # [VERIFY only] post-lane file assert — NOT sent on wave-start
    evidence: /absolute/path/to/run_gateflow/evidence/implement-lane-live.json
    timeout_s: 3600
    # [API] POST /api/v1/waves/implement/start for this feature only
    wave_start:
      org: drivestream-lab
      repo: gateflow
      workspace: ""
      start_node: pre-implement
      runner: cursor
      model_id: cursor/auto
      initiative_id: ""
      wave_id: W0
      ticket_id: ""
      # slug only — do NOT prefix w0-/w1- (wave_id already inserts the wave token)
      branch_slug: implement-lane
      # Skills leave the tree dirty; ForgeClient publishes after the hop (no skill git commit).

  # Spec lane: POST /api/v1/waves/spec/start (requires pin orchestrated start_node)
  #   Head branch is always feature/{INIT}-spec (wave_id + branch_slug still required
  #   on the API body but ignored for head naming).
  #   .venv/bin/python -m tests.verify.verify_spec_lane
  spec_lane:
    enabled: false
    evidence: /absolute/path/to/run_gateflow/evidence/spec-lane-live.json
    timeout_s: 3600
    wave_start:
      start_node: spec-draft
      runner: cursor
      model_id: cursor/auto
      wave_id: W0
      branch_slug: spec-lane
      # Required when enabled:
      # meta_pr_url: https://github.com/drivestream-lab/prayog-meta/pull/N
      # meta_workspace: /absolute/path/to/prayog-meta
      # workspace: /absolute/path/to/app/checkout
      meta_pr_url: ""
      meta_workspace: ""
      workspace: ""

  # Closeout start (INIT-GATEFLOW-007 / Pass-2):
  #   .venv/bin/python -m tests.verify.verify_wave_closeout
  # Auth/validation always run; set enabled + pr_number for happy enqueue.
  # Publish head is resolved from the open wave PR (pr_number) — do not invent
  # a sibling …-{branch_slug} head. branch_slug is optional / non-binding.
  # W2 dogfood: dogfood: true + gateflow.require_worker: true → poll Pass-2 to
  # wave-signoff (learning-extract → ground-spec); assert Learning-Extract artifact.
  wave_closeout:
    enabled: false
    pr_number: 0
    prior_run_id: ""
    dogfood: false
    timeout_s: 3600
    assert_learning_artifact: true
    wave_start:
      initiative_id: INIT-GATEFLOW-007
      wave_id: W0
      ticket_id: "85"
      # Optional; ignored for publish head when pr_number is set (PR head is SSOT).
      branch_slug: implement-lane
      runner: cursor
      model_id: cursor/auto
      # Absolute checkout with tip under test (dogfood reads Learning-Extract here)
      workspace: ""

  # WorkManifest → board EPIC + wave tickets (before implement_lane)
  #   .venv/bin/python -m tests.verify.verify_create_tickets
  # Seeds via POST /api/v1/board/tickets (same projection as forge create_board_tickets).
  # Optional authorize_run_id: use forge/authorize when a run is STOPPED at
  # board-tickets-action instead of the board projection path.
  create_tickets:
    enabled: false
    workspace: ""
    plan_path: docs/specification/reports/Implementation-Plan-INIT-GATEFLOW-010.md
    initiative: INIT-GATEFLOW-010
    wave_id: W0
    dry_run: false
    # Deterministic org Project v2 number (gh project list --owner <org>).
    # drivestream-lab Board → 3
    project_number: 3
    project_owner: ""
    authorize_run_id: ""


forge:
  org: drivestream-lab
  repo: gateflow
  base_branch: develop
  # probe_branch_prefix: gateflow/debug-probe-
