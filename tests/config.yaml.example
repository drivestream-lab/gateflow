# Copy to tests/config.yaml (gitignored) for local live debug / verify.
#
# gateflow:  verification client → running Gateflow product
# features:  optional per-capability knobs (omit sections you do not run)
# forge:     debug ForgeClient probe only
#
# Secrets for the verify client (PROGRAMME_SERVICE_TOKEN, GITHUB_WEBHOOK_SECRET)
# stay in .env for now. CURSOR_API_KEY is Gateflow runtime (.env when you make run)
# — not verify config. verify_all only needs gateflow:; deep lanes need features.*.

gateflow:
  base_url: http://127.0.0.1:8080
  # True when worker is up (PR-at-start assert in verify_pr_thread; required for lanes)
  require_worker: false
  org: drivestream-lab
  repo: gateflow
  base_branch: develop

# Product smoke (verify_all) uses gateflow: + ephemeral wave identity in scripts.
# Feature sections below are optional.

features:
  # Coding hops: pre-implement → loop-spec → STOP at live-verify
  #   .venv/bin/python -m tests.verify.verify_implement_lane
  implement_lane:
    enabled: false
    # [VERIFY only] post-lane file assert — NOT sent on wave-start
    evidence: /absolute/path/to/run_gateflow/evidence/implement-lane-live.json
    timeout_s: 3600
    # [API] POST /api/v1/waves/implement/start for this feature only
    wave_start:
      org: drivestream-lab
      repo: gateflow
      workspace: ""
      start_node: pre-implement
      runner: cursor
      model_id: cursor/auto
      initiative_id: ""
      wave_id: W0
      ticket_id: ""
      # slug only — do NOT prefix w0-/w1- (wave_id already inserts the wave token)
      branch_slug: implement-lane
      # Skills leave the tree dirty; ForgeClient publishes after the hop (no skill git commit).

  # Spec lane: POST /api/v1/waves/spec/start (requires pin orchestrated start_node)
  #   .venv/bin/python -m tests.verify.verify_spec_lane
  spec_lane:
    enabled: false
    evidence: /absolute/path/to/run_gateflow/evidence/spec-lane-live.json
    timeout_s: 3600
    wave_start:
      start_node: spec-draft
      runner: cursor
      model_id: cursor/auto
      wave_id: W0
      branch_slug: spec-lane
      # Required when enabled:
      # meta_pr_url: https://github.com/drivestream-lab/prayog-meta/pull/N
      # meta_workspace: /absolute/path/to/prayog-meta
      # workspace: /absolute/path/to/app/checkout
      meta_pr_url: ""
      meta_workspace: ""
      workspace: ""

  # Closeout start (INIT-GATEFLOW-007):
  #   .venv/bin/python -m tests.verify.verify_wave_closeout
  # Auth/validation always run; set enabled + pr_number for happy enqueue.
  # W2 dogfood: dogfood: true + gateflow.require_worker: true → poll Pass-2 to
  # wave-signoff (learning-extract → ground-spec); assert Learning-Extract artifact.
  wave_closeout:
    enabled: false
    pr_number: 0
    prior_run_id: ""
    dogfood: false
    timeout_s: 3600
    assert_learning_artifact: true
    wave_start:
      initiative_id: INIT-GATEFLOW-007
      wave_id: W0
      ticket_id: "85"
      branch_slug: closeout-start
      runner: cursor
      model_id: cursor/auto
      # Absolute checkout with tip under test (dogfood reads Learning-Extract here)
      workspace: ""


forge:
  org: drivestream-lab
  repo: gateflow
  base_branch: develop
  # probe_branch_prefix: gateflow/debug-probe-
