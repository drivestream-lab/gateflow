# launchpad harness — skill symlinks (apply-harness)
# Re-run: launchpad apply-harness --apply
# Use /* not /*/ — git treats skill mirrors as symlinks, not directories.
.harness/skills/
.agents/skills/*
!prayog-skills/
.claude/skills/*
.cursor/skills/

# Local environment / secrets
.env
.env.*
!.env.example
!.env.*.example
github-secrets/
*.pem
!tests/fixtures/*.pem

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/
.tox/
.cache/

# Runtime / local artifacts
logs/
*.log
.DS_Store

# Live verify / debug local config (committed example only)
tests/config.yaml
!tests/config.yaml.example
